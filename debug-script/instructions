#!/bin/sh
# counts instructions for a standard workload
set -e

OUTFILE="cachegrind.rpsee.$(git describe --always --dirty)-$(date +%s)"
LAST=$(ls -t cachegrind.rpsee.* 2>/dev/null | head -1)

CARGO_PROFILE_RELEASE_DEBUG=true \
cargo build \
  --bin=rpsee \
  --release

status=0
timeout 60s valgrind \
  --tool=cachegrind \
  --cachegrind-out-file="$OUTFILE" \
  ./target/release/rpsee --config example_config.toml || status=$?

if [ "$status" -ne 0 ] && [ "$status" -ne 124 ]; then
    exit "$status"
fi

if [ -n "$LAST" ]; then
    echo "Last cachegrind output: $LAST new file: $OUTFILE"
    cg_annotate --diff "$LAST" "$OUTFILE" | tail -1
else
    echo "Cachegrind output: $OUTFILE"
fi
